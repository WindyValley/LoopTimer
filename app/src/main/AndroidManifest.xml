<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.VIBRATE"/>

    <!--
      Phase boundaries are scheduled with AlarmManager.setAlarmClock so the timer stays accurate
      while the process is idle or the device is dozing. USE_EXACT_ALARM is granted on install for
      apps whose core function is a clock/timer, so no runtime prompt is needed.
      NOTE: this app never sends AlarmClock.ACTION_SET_ALARM, so it does not create entries in the
      user's clock app.
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>

    <!--
      The service only runs in the foreground while the alarm is actually audible; between phases
      nothing runs at all. mediaPlayback matches that use (an alarm sound via MediaPlayer) and
      avoids the specialUse type, which requires a manual policy review.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LoopTimer">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.LoopTimer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity
            android:name=".PresetListActivity"
            android:exported="false"
            android:theme="@style/Theme.LoopTimer"/>

        <activity
            android:name=".PresetEditActivity"
            android:exported="false"
            android:theme="@style/Theme.LoopTimer"/>

        <service
            android:name=".service.TimerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"/>
    </application>

</manifest>
